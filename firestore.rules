rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LEGACY AUTH MODE: Application uses custom auth without Firebase Auth tokens.
    // Must allow public read/write for the app to function (until refactored).
    // TRANSITION RULES: Locking down business data, keeping users open for migration.
    
    // 1. Users Collection (Open Read for Legacy Login check, Write requires Auth)
    match /users/{email} {
      allow read: if true; // Temporary: Needed for unauthenticated users to verify legacy password
      allow write: if request.auth != null; // Registration happens AFTER Auth creation
    }

    // 2. Business Data (EMERGENCY: Allowed read to restore visibility)
    match /parts/{docId} { allow read: if true; allow write: if true; }
    match /shipments/{docId} { allow read: if true; allow write: if true; }
    match /vessel_tracking/{docId} { allow read: if true; allow write: if true; }
    match /equipment_tracking/{docId} { allow read: if true; allow write: if true; }
    match /customs_clearance/{docId} { allow read: if true; allow write: if true; }
    match /pre_alerts/{docId} { allow read: if true; allow write: if true; }
    match /commercial_invoices/{docId} { allow read: if true; allow write: if true; }
    match /suppliers/{docId} { allow read: if true; allow write: if true; }
    match /logistics/{docId} { allow read: if true; allow write: if true; }
    
    // 3. System Data
    match /logs/{docId} { allow read, write: if true; }
    match /daily_changes/{docId} { allow read, write: if true; }
    match /master_data_reports/{docId} { allow read, write: if true; }
    match /system_metadata/{docId} { allow read: if true; allow write: if true; } // Metadata public read ok? Parts version needs to be read by everyone? Maybe.

    // 4. Default Block (Catch-all)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
