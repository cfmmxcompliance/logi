rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LEGACY AUTH MODE: Application uses custom auth without Firebase Auth tokens.
    // Must allow public read/write for the app to function (until refactored).
    // TRANSITION RULES: Locking down business data, keeping users open for migration.
    
    // 1. Users Collection (Open Read/Write for Legacy Login, Registration, and Offline Migration)
    // Note: App uses custom Firestore-based auth; writes happen before Firebase Auth is established.
    match /users/{email} {
      allow read, write: if true;
    }

    // 2. Business Data (EMERGENCY: Allowed read to restore visibility)
    match /parts/{docId} { allow read, write: if true; }
    match /shipments/{docId} { allow read, write: if true; }
    match /vessel_tracking/{docId} { allow read, write: if true; }
    match /equipment_tracking/{docId} { allow read, write: if true; }
    match /customs_clearance/{docId} { allow read, write: if true; }
    match /pre_alerts/{docId} { allow read, write: if true; }
    match /commercial_invoices/{docId} { allow read, write: if true; }
    match /costs/{docId} { allow read, write: if true; }
    match /electronic_dossiers/{docId} { allow read, write: if true; }
    match /data_stage_drafts/{docId} { allow read, write: if true; }
    match /snapshots/{docId} { allow read, write: if true; }
    match /data_stage_reports/{docId} { allow read, write: if true; }
    match /data_stage_reports/{docId}/items/{itemId} { allow read, write: if true; }
    match /training_submissions/{docId} { allow read, write: if true; }
    match /audit_subscriptions/{docId} { allow read, write: if true; }
    match /suppliers/{docId} { allow read, write: if true; }
    match /logistics/{docId} { allow read, write: if true; }
    match /users/{docId} { allow read, write: if true; }
    match /logs/{docId} { allow read, write: if true; }
    match /daily_changes/{docId} { allow read, write: if true; }
    match /master_data_reports/{docId} { allow read, write: if true; }
    match /system_metadata/{docId} { allow read, write: if true; }
    match /electronic_dossiers_v2/{docId} { allow read, write: if true; }
    match /cfdi_invoices/{docId} { allow read, write: if true; }
    match /xml_ci/{docId} { allow read, write: if true; }
    match /models/{docId} { allow read, write: if true; }
    match /carriers/{docId} { allow read, write: if true; }
    match /drivers/{docId} { allow read, write: if true; }
    match /cajas/{docId} { allow read, write: if true; }
    match /transport_lines/{docId} { allow read, write: if true; }
    match /pricing_matrix/{docId} { allow read, write: if true; }
    match /shipping_schedules/{docId} { allow read, write: if true; }
    match /apendice10/{docId} { allow read, write: if true; }
    match /asignacion_cajas/{docId} { allow read, write: if true; }
    match /sellos/{docId} { allow read, write: if true; }
    match /liberacionesCaja/{docId} { allow read, write: if true; }
    match /liberacionesDock/{docId} { allow read, write: if true; }
    match /productos/{docId} { allow read, write: if true; }
    match /BPM/{docId} { allow read, write: if true; }
    match /counters/{docId} { allow read, write: if true; }
    match /fianzas/{docId} { allow read, write: if true; }
    match /spare_parts_tracking/{docId} { allow read, write: if true; }
    match /demandasCarga53/{docId} { allow read, write: if true; }
    match /demandasCarga53/{docId}/items/{itemId} { allow read, write: if true; }
    match /ventanasCarga53/{docId} { allow read, write: if true; }
    match /reservasVentanasCarga53/{docId} { allow read, write: if true; }
    match /vigilancia/{docId} { allow read, write: if true; }
    match /wms_vehicles/{docId} { allow read, write: if true; }
    match /wms_transfers/{docId} { allow read, write: if true; }
    match /wms_vehicles/{docId} { allow read, write: if true; }
    match /wms_transfers/{docId} { allow read, write: if true; }
    match /vigilancia/{docId} { allow read, write: if true; }

    match /daily_reports/{docId} { allow read, write: if true; }
    match /system_metadata/{docId} { allow read, write: if true; }
    match /daily_changes/{docId} { allow read, write: if true; }

    // 4. Default Block (Catch-all)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
